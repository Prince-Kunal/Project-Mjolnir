{
  "name": "project-mjolnir",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mjolnir/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:functions": "deno test --allow-env --allow-net --config supabase/functions/deno.json supabase/functions",
    "test:db": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/db-types/src/database.ts",
    "functions:serve": "supabase functions serve --env-file supabase/.env",
    "e2e": "pnpm --filter @mjolnir/web e2e",
    "gen:shared-tests": "node scripts/gen-shared-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
