# Local values come from `supabase status` after `supabase start`.
# Only the publishable (anon) key belongs here: the service key never reaches the web app.
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web Push applicationServerKey: `pnpm gen:vapid` (public half; the private half goes in supabase/.env).
VITE_VAPID_PUBLIC_KEY=
